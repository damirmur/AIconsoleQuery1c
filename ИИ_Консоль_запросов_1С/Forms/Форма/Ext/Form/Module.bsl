&НаКлиенте
Процедура ТестBuddy(Команда) Экспорт
	ЗаписатьЛогФормы("ТестBuddy нажата");
	Если Не ЗначениеЗаполнено(Объект.ТокенДоступа) Тогда
		ПоказатьПредупреждение(, "Введите токен доступа (LLM_PROXY_KEY) в поле Токен");
		Возврат;
	КонецЕсли;
	Попытка
		РезМодели = ТестBuddyПроверитьМоделиНаСервере();
		Если Не РезМодели.Успех Тогда
			ПоказатьПредупреждение(, "Buddy GET /v1/models ERR: " + РезМодели.Ошибка);
			Возврат;
		КонецЕсли;
		Сообщить("Buddy models OK: " + Строка(РезМодели.Данные), СтатусСообщения.Информация);
	Исключение
		ПоказатьПредупреждение(, "Ошибка проверки моделей: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Попытка
		Рез = ТестBuddyНаСервере("Привет, ответь одним словом: тест");
		Если Рез.Успех Тогда
			ПоказатьПредупреждение(, "Buddy POST /v1/chat/completions OK: " + Рез.ТекстОтвета);
		Иначе
			ПоказатьПредупреждение(, "Buddy ERR (502 — апстрим code.1c.ai недоступен / 500 — нет ONEC_AI_TOKEN): " + Рез.Ошибка);
		КонецЕсли;
	Исключение
		ПоказатьПредупреждение(, "Исключение ТестBuddy: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

