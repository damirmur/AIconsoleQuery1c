КонецПроцедуры



Функция ПроверитьКонфигурциюНаСервере()

	// 2d: серверная проверка manager-1c отменена — возвращаем локальный кэш Current как "active", открыт через Buddy
	Попытка
		ОбъектДляСервера = РеквизитФормыВЗначение("Объект");
		РезBuddy = ОбъектДляСервера.Buddy_ПроверитьДоступность();
		Если РезBuddy.Успех Тогда
			Возврат Новый Структура("Успех, Данные, Ошибка, StatusId, ИмяКонфигурации, СтатусКонфигурации", Истина, Новый Структура("name, title", "Локальная", "Локальная"), "", "active", "Локальная", "Готова (Buddy)");
		Иначе
			// даже при 502 кэш Current считается активным — форма открывается
			Возврат Новый Структура("Успех, Данные, Ошибка, StatusId, ИмяКонфигурации, СтатусКонфигурации", Истина, Новый Структура("name, title", "Локальная", "Локальная"), "", "active", "Локальная", "Автономный (кэш Current)");
		КонецЕсли;
	Исключение
		Возврат Новый Структура("Успех, Данные, Ошибка, StatusId, ИмяКонфигурации, СтатусКонфигурации", Истина, Неопределено, "", "active", "Локальная", "Автономный (исключение)");
	КонецПопытки;

КонецФункции



&НаКлиенте

Процедура ОбновитьЗаголовокФормы(ИмяКонфигурации = "", СтатусКонфигурации = "") Экспорт

	Если ПустаяСтрока(СтатусКонфигурации) Тогда

		СтатусКонфигурации = "Инициализация";

	КонецЕсли;

	

	ВерсияОбработки = ПолучитьВерсиюВнешнейОбработкиДляЗаголовка();

	Если ПустаяСтрока(ВерсияОбработки) Тогда

		ВерсияОбработки = "?";

	КонецЕсли;

	

	ЭтаФорма.Заголовок = "Aether Lab " + ВерсияОбработки + " (" + СтатусКонфигурации + ")";

КонецПроцедуры



&НаСервере

Функция ПолучитьВерсиюВнешнейОбработкиДляЗаголовка() Экспорт

	ОбъектДляСервера = РеквизитФормыВЗначение("Объект");

	Если ОбъектДляСервера = Неопределено Тогда

		Возврат "";

	КонецЕсли;

	

	Возврат Строка(ОбъектДляСервера.ВерсияОбъекта());

КонецФункции

