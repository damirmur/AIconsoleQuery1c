	КонецЕсли;

	

	Объект.ТокенДоступа = "";

	УдалитьНастройку("AL_TOKEN");

	УдалитьНастройкуИзLegacy("AL_TOKEN");

	

	ОписаниеОповещения = Новый ОписаниеОповещения("ВводТокенаЗавершение", ЭтотОбъект);

	ПоказатьВводЗначения(ОписаниеОповещения, "", НСтр("ru = 'Введите токен доступа'"));

