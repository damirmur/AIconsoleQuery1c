&НаКлиенте

Функция ЭтоОшибкаАвторизации(РезультатПроверки) Экспорт

	Если РезультатПроверки = Неопределено Тогда

		Возврат Ложь;

	КонецЕсли;

	

	Ошибка = "";

	Если РезультатПроверки.Свойство("Ошибка") И ЗначениеЗаполнено(РезультатПроверки.Ошибка) Тогда

		Ошибка = НРег(Строка(РезультатПроверки.Ошибка));

	КонецЕсли;

	

	Возврат (Найти(Ошибка, "401") > 0) Или (Найти(Ошибка, "unauthorized") > 0) Или (Найти(Ошибка, "авториза") > 0);

КонецФункции



&НаКлиенте

Функция ЭтоОшибкаОтсутствияКонфигурации(РезультатПроверки) Экспорт

	Если РезультатПроверки = Неопределено Тогда

		Возврат Ложь;

	КонецЕсли;

	

	Ошибка = "";

	Если РезультатПроверки.Свойство("Ошибка") И ЗначениеЗаполнено(РезультатПроверки.Ошибка) Тогда

		Ошибка = НРег(Строка(РезультатПроверки.Ошибка));

	КонецЕсли;

	

	Возврат (Найти(Ошибка, "404") > 0) Или (Найти(Ошибка, "ресурс не найден") > 0) Или (Найти(Ошибка, "not found") > 0);

КонецФункции



&НаКлиенте

Функция ЭтоОшибкаДоступа(РезультатПроверки) Экспорт

	Если РезультатПроверки = Неопределено Тогда

		Возврат Ложь;

	КонецЕсли;

	

	Ошибка = "";

	Если РезультатПроверки.Свойство("Ошибка") И ЗначениеЗаполнено(РезультатПроверки.Ошибка) Тогда

		Ошибка = НРег(Строка(РезультатПроверки.Ошибка));

	КонецЕсли;

	

	Возврат ЭтоОшибкаАвторизации(РезультатПроверки)

		Или (Найти(Ошибка, "403") > 0)

		Или (Найти(Ошибка, "forbidden") > 0)

		Или (Найти(Ошибка, "доступ запрещен") > 0)

		Или (Найти(Ошибка, "access denied") > 0);

КонецФункции



&НаКлиенте

Процедура ПоказатьДиалогОшибкиКонфигурации(ТекстОшибки) Экспорт

	Если ДиалогОшибкиКонфигурацииПоказан Тогда

		Возврат;

	КонецЕсли;

	

	ДиалогОшибкиКонфигурацииПоказан = Истина;

	Текст = "Не удалось получить состояние конфигурации.";

	Если ЗначениеЗаполнено(ТекстОшибки) Тогда

		Текст = Текст + Символы.ПС + ТекстОшибки;

	КонецЕсли;

	// 502 — апстрим 1c-buddy (AGENTS.md:324 / ОбъектМодуль Buddy_ChatCompletions) — транзент, не закрываем форму
	Если Найти(НРег(ТекстОшибки), "502") > 0 Тогда
		Текст = Текст + Символы.ПС + "Сервер ИИ временно недоступен (502). Повторите позже, форма останется открытой.";
	КонецЕсли;
	Текст = Текст + Символы.ПС + "Повторить попытку?";
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаОшибкиКонфигурацииЗавершение", ЭтотОбъект, ТекстОшибки);

	ПоказатьВопрос(ОписаниеОповещения, Текст, РежимДиалогаВопрос.ОКОтмена);

КонецПроцедуры



&НаКлиенте

Процедура ОбработкаОшибкиКонфигурацииЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ДиалогОшибкиКонфигурацииПоказан = Ложь;

	// 502 — не закрываем форму ни при ОК, ни при Отмена
	Ошибка502 = Ложь;
	Если ДополнительныеПараметры <> Неопределено И Найти(НРег(Строка(ДополнительныеПараметры)), "502") > 0 Тогда
		Ошибка502 = Истина;
	ИначеЕсли Найти(НРег(СтатусКонфигурации), "502") > 0 Тогда
		Ошибка502 = Истина;
	КонецЕсли;
	Если Ошибка502 Тогда
		Если Результат = КодВозвратаДиалога.ОК Тогда
			ИнициализироватьКонфигурациюИСессию();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Результат = КодВозвратаДиалога.ОК Тогда

		ИнициализироватьКонфигурациюИСессию();

	Иначе

		ЭтаФорма.Закрыть();

	КонецЕсли;

КонецПроцедуры



&НаКлиенте

// Миграция 1c-buddy: Проверка конфигурации Aether (active/indexing) заменена на Buddy_ПроверитьДоступность + локальный кэш 2d (ХранилищеОбщихНастроек Current)

Процедура ИнициализироватьКонфигурациюИСессию() Экспорт
	ЗаписатьЛогФормы("ИнициализироватьКонфигурациюИСессию старт, Статус=" + СтатусКонфигурации);

	// 2d/B: локальный кэш Current только ХранилищеОбщихНастроек, активные расширения, полный Реквизит:Тип, инвалидация по хешу при ПриОткрытии (AGENTS.md:79 навыков)
	Попытка
		ЗаписатьЛогФормы("Инициализировать: вызываю Buddy_ПроверитьДоступность");
		РезBuddy = ТестBuddyПроверитьМоделиНаСервере();
		ЗаписатьЛогФормы("Buddy результат: Успех=" + РезBuddy.Успех + ", Ошибка=" + РезBuddy.Ошибка);
		Если РезBuddy.Успех Тогда
			СтатусКонфигурации = "Готова (Buddy)";
		ИначеЕсли Найти(НРег(РезBuddy.Ошибка), "502") > 0 Тогда
			СтатусКонфигурации = "Автономный (502) - Тест Buddy доступен позже";
		ИначеЕсли Найти(НРег(РезBuddy.Ошибка), "401") > 0 Или Найти(НРег(РезBuddy.Ошибка), "403") > 0 Тогда
			СтатусКонфигурации = "Ошибка авторизации Buddy";
			ОбновитьЗаголовокФормы(, СтатусКонфигурации);
			ЗапроситьНовыйТокен("Токен Buddy недействителен: " + РезBuddy.Ошибка);
			Возврат;
		Иначе
			СтатусКонфигурации = "Автономный (Buddy: " + РезBuddy.Ошибка + ")";
		КонецЕсли;
		ОбновитьЗаголовокФормы(, СтатусКонфигурации);
	Исключение
		СтатусКонфигурации = "Автономный (исключение Buddy)";
		ОбновитьЗаголовокФормы(, СтатусКонфигурации);
	КонецПопытки;
	// B: при открытии проверяем хеш, предлагаем только если кэш есть и изменился; если кэша нет — создаем тихо
	Попытка
		ЗаписатьЛогФормы("Инициализировать: проверка кэша метаданных по хешу");
		ЕстьКэш = КэшМетаданныхЕстьНаСервере();
		Если Не ЕстьКэш Тогда
			ЗаписатьЛогФормы("Кэш метаданных пуст — создаем в фоне");
			ОбеспечитьКэшМетаданныхНаСервере();
			ЗаписатьЛогФормы("Кэш метаданных создан");
		Иначе
			Актуален = КэшМетаданныхАктуаленНаСервере();
			Если Актуален Тогда
				ЗаписатьЛогФормы("Кэш метаданных актуален");
			Иначе
				ЗаписатьЛогФормы("Кэш метаданных неактуален — предлагаем обновить");
				ОписаниеОповещения = Новый ОписаниеОповещения("ПредложитьОбновитьКэшЗавершение", ЭтотОбъект);
				ПоказатьВопрос(ОписаниеОповещения, "Описание конфигурации изменилось (версия или состав расширений). Обновить кэш метаданных? Занять 1-3 мин. При отказе будет использована старая схема.", РежимДиалогаВопрос.ДаНет);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписатьЛогФормы("Ошибка проверки кэша метаданных: " + ОписаниеОшибки());
	КонецПопытки;

	// Сессия Buddy stateless — проверка не требуется, оставляем для совместимости
	Попытка
		ПроверитьСессиюНаКлиенте();
	Исключение
	КонецПопытки;

КонецПроцедуры



