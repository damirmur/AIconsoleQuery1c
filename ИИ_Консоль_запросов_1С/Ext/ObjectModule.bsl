#Область СлужебныеФункции



// Экранирует HTML-теги

Функция ЭкранироватьHTML(Текст)

	Текст = СтрЗаменить(Текст, "&", "&amp;");

	Текст = СтрЗаменить(Текст, "<", "&lt;");

	Текст = СтрЗаменить(Текст, ">", "&gt;");

	Текст = СтрЗаменить(Текст, """", "&quot;");

	Возврат Текст;

КонецФункции



// Экранирует строку для безопасной вставки в HTML-атрибут.

Функция ЭкранироватьДляHTMLАтрибута(Текст)

	Результат = Текст;

	Результат = СтрЗаменить(Результат, "&", "&amp;");

	Результат = СтрЗаменить(Результат, """", "&quot;");

	Результат = СтрЗаменить(Результат, "'", "&#39;");

	Возврат Результат;

КонецФункции



