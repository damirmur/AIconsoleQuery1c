// Модуль для работы с API загрузки файлов, управления конфигурациями и сессиями запросов

// Проект: 1C_development

// Платформа: 1C:Enterprise 8.3.23



#Область ПрограммныйИнтерфейс



// Загружает файл в API

// Параметры:

//  ПутьКФайлу - Строка - путь к файлу на сервере

//  ИмяФайла - Строка - имя файла (например, "meta.xml")

// Возвращаемое значение:

//  Структура - результат запроса: ИдентификаторФайла (Число), Успех (Булево), Ошибка (Строка)

Функция ЗагрузитьФайл(ПутьКФайлу, ИмяФайла) Экспорт

	

	// Проверка входных параметров

	Если Не ЗначениеЗаполнено(ПутьКФайлу) Или Не ЗначениеЗаполнено(ИмяФайла) Тогда

		Возврат Новый Структура("Успех, Ошибка", Ложь, "Не указан путь к файлу или имя файла");

	КонецЕсли;

	

	// Кодирование файла в Base64 

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(ПутьКФайлу);

	//ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);

	СтрокаBase64 = Base64Строка(ДвоичныеДанные);

	

	// Формирование JSON-данных

	Данные = Новый Структура;

	Данные.Вставить("file", СтрокаBase64);

	Данные.Вставить("filename", ИмяФайла);

	Данные.Вставить("name", ИмяФайла);

	

	// Отправка POST-запроса

	Результат = ВыполнитьHTTPЗапрос("/api/file-manager/files/", "POST", Данные);

	

	// Обработка ответа

	Если Результат.Успех Тогда

		ОтветJSON = ПрочитатьJSONИзСтроки(Результат.Ответ);

		Возврат Новый Структура("Успех, ИдентификаторФайла, Ошибка", Истина, ОтветJSON.id, "");

	Иначе

		Возврат Новый Структура("Успех, Ошибка", Ложь, Результат.Ошибка);

	КонецЕсли;

	

КонецФункции



// Создает конфигурацию в API

// Параметры:

//  ИдентификаторФайла - Число - идентификатор загруженного файла

// Возвращаемое значение:

//  Структура - результат запроса: СсылкаКонфигурации (Строка), Успех (Булево), Ошибка (Строка)

Функция СоздатьКонфигурацию(ИдентификаторФайла) Экспорт

	

	// Формирование JSON-данных

	Данные = Новый Структура;

	Данные.Вставить("uploaded_file_id", ИдентификаторФайла);

	

	// Отправка POST-запроса

	Результат = ВыполнитьHTTPЗапрос("/api/manager-1c/configs/", "POST", Данные);

	

// Обработка ответа

	Если Результат.Успех Тогда

		ОтветJSON = ПрочитатьJSONИзСтроки(Результат.Ответ);

		Возврат Новый Структура("Успех, СсылкаКонфигурации, Ошибка, Обновлено", Истина, ОтветJSON.ref, "", ОтветJSON.updated_at);

	Иначе

		Возврат Новый Структура("Успех, Ошибка", Ложь, Результат.Ошибка);

	КонецЕсли;

	

КонецФункции



// Собирает запросы отчетов для массовой отправки на backend.

// Возвращаемое значение:

//  Массив структур: name, data_composition_schema_name, data_set_name, query_text

Функция СобратьЗапросыОтчетовДляBulkLoad() Экспорт

	

	Результат = Новый Массив;

	УникальныеЗаписи = Новый Соответствие;

	СтрокиОтчетов = ПолучитьСтрокиОтчетовДляВыгрузки();

	

	Для Каждого СтрокаОтчета Из СтрокиОтчетов Цикл

		Если Не СтрокаОтчета.ЭтоЗапросныйНабор Тогда

			Продолжить;

		КонецЕсли;

		

		Ключ = СтрокаОтчета.Отчет + "|" + СтрокаОтчета.Схема + "|" + СтрокаОтчета.НаборДанных;

		Запись = Новый Структура;

		Запись.Вставить("name", СтрокаОтчета.Отчет);

		Запись.Вставить("data_composition_schema_name", СтрокаОтчета.Схема);

		Запись.Вставить("data_set_name", СтрокаОтчета.НаборДанных);

		Запись.Вставить("query_text", СтрокаОтчета.Запрос);

		УникальныеЗаписи.Вставить(Ключ, Запись);

	КонецЦикла;

	

	Для Каждого ЭлементСоответствия Из УникальныеЗаписи Цикл

		Результат.Добавить(ЭлементСоответствия.Значение);

	КонецЦикла;

	

	Возврат Результат;

	

КонецФункции



// Загружает запросы отчетов на backend через существующий массовый endpoint.

// Параметры:

//  СсылкаКонфигурации - Строка - UUID конфигурации

//  РазмерПакета - Число - размер пакета для отправки

// Возвращаемое значение:

//  Структура - Успех, Обновлено, НеНайдено, Всего, Ошибка, Ошибки

Функция МассовоЗагрузитьЗапросыОтчетов(СсылкаКонфигурации, РазмерПакета = 200) Экспорт

	

	Если Не ЗначениеЗаполнено(СсылкаКонфигурации) Тогда

		Возврат Новый Структура("Успех, Обновлено, НеНайдено, Всего, Ошибка, Ошибки", Ложь, 0, 0, 0, "Не передана ссылка конфигурации", Новый Массив);

	КонецЕсли;

	

	Если РазмерПакета <= 0 Тогда

		РазмерПакета = 200;

	КонецЕсли;

	

	ЗаписиОтчетов = СобратьЗапросыОтчетовДляBulkLoad();

	Всего = ЗаписиОтчетов.Количество();

	Обновлено = 0;

	НеНайдено = 0;

	Ошибки = Новый Массив;

	

	Если Всего = 0 Тогда

		Возврат Новый Структура("Успех, Обновлено, НеНайдено, Всего, Ошибка, Ошибки", Истина, 0, 0, 0, "", Ошибки);

	КонецЕсли;

	

	Позиция = 0;

	Пока Позиция < Всего Цикл

		Пакет = Новый Массив;

		Для Счетчик = Позиция По Мин(Позиция + РазмерПакета - 1, Всего - 1) Цикл

			Пакет.Добавить(ЗаписиОтчетов[Счетчик]);

		КонецЦикла;

		

		Данные = Новый Структура;

		Данные.Вставить("configuration_ref", Строка(СсылкаКонфигурации));

		Данные.Вставить("reports", Пакет);

		

		Ответ = ВыполнитьHTTPЗапрос("/api/manager-1c/reports/bulk-load-queries/", "POST", Данные);

		Если Не Ответ.Успех Тогда

			Возврат Новый Структура("Успех, Обновлено, НеНайдено, Всего, Ошибка, Ошибки", Ложь, Обновлено, НеНайдено, Всего, Ответ.Ошибка, Ошибки);

		КонецЕсли;

		

		ДанныеОтвета = ПрочитатьJSONИзСтроки(Ответ.Ответ);

		Если ТипЗнч(ДанныеОтвета) = Тип("Структура") Тогда

			Если ДанныеОтвета.Свойство("updated") Тогда

				Обновлено = Обновлено + Число(ДанныеОтвета.updated);

			КонецЕсли;

			Если ДанныеОтвета.Свойство("not_found") Тогда

				НеНайдено = НеНайдено + Число(ДанныеОтвета.not_found);

			КонецЕсли;

			Если ДанныеОтвета.Свойство("errors") И ЗначениеЗаполнено(ДанныеОтвета.errors) Тогда

				Для Каждого ОшибкаЭлемент Из ДанныеОтвета.errors Цикл

					Ошибки.Добавить(ОшибкаЭлемент);

				КонецЦикла;

			КонецЕсли;

		КонецЕсли;

		

		Позиция = Позиция + РазмерПакета;

	КонецЦикла;

	

	Возврат Новый Структура("Успех, Обновлено, НеНайдено, Всего, Ошибка, Ошибки", Истина, Обновлено, НеНайдено, Всего, "", Ошибки);

	

КонецФункции



