// Формирует JSON из структуры

// Параметры:

//  Данные - Структура - данные для сериализации

// Возвращаемое значение:

//  Строка - JSON-строка

Функция СформироватьJSON(Данные)

	

	ЗаписьJSON = Новый ЗаписьJSON;

	ЗаписьJSON.УстановитьСтроку();

	ЗаписатьJSON(ЗаписьJSON, Данные);

	Возврат ЗаписьJSON.Закрыть();

	

КонецФункции



// Читает JSON-строку в структуру

// Параметры:

//  СтрокаJSON - Строка - строка в формате JSON

// Возвращаемое значение:

//  Структура, Массив - результат десериализации

Функция ПрочитатьJSONИзСтроки(СтрокаJSON)

	

	ЧтениеJSON = Новый ЧтениеJSON;

	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);

	Результат = ПрочитатьJSON(ЧтениеJSON);

	ЧтениеJSON.Закрыть();

	Возврат Результат;

	

КонецФункции



// Возвращает осмысленный текст ошибки из JSON-ответа API.

Функция ИзвлечьДетальОшибкиИзJsonОтветаAPI(ТелоJson)

	

	Если ПустаяСтрока(ТелоJson) Тогда

		Возврат "";

	КонецЕсли;

	

	Попытка

		Данные = ПрочитатьJSONИзСтроки(ТелоJson);

		Если ТипЗнч(Данные) = Тип("Строка") Тогда

			Возврат Строка(Данные);

		КонецЕсли;

		Если ТипЗнч(Данные) = Тип("Массив") Тогда

			Возврат ИзвлечьТекстОшибкиИзJSONМассива(Данные);

		КонецЕсли;

		Если ТипЗнч(Данные) = Тип("Структура") Тогда

			Если Данные.Свойство("detail") Тогда

				Возврат Строка(Данные.detail);

			КонецЕсли;

			Если Данные.Свойство("error") Тогда

				Возврат Строка(Данные.error);

			КонецЕсли;

			Если Данные.Свойство("details") Тогда

				Возврат ИзвлечьТекстОшибкиИзJSONЗначения(Данные.details);

			КонецЕсли;

			Если Данные.Свойство("non_field_errors") Тогда

				Возврат ИзвлечьТекстОшибкиИзJSONЗначения(Данные.non_field_errors);

			КонецЕсли;

			Возврат ИзвлечьТекстОшибкиИзJSONСтруктуры(Данные);

		КонецЕсли;

	Исключение

		// Не JSON или иной формат — оставляем разбор вызывающему коду

	КонецПопытки;

	

	Возврат "";

	

КонецФункции



Функция ИзвлечьТекстОшибкиИзJSONЗначения(ЗначениеОшибки)

	

	Если ТипЗнч(ЗначениеОшибки) = Тип("Строка") Тогда

		Возврат Строка(ЗначениеОшибки);

	КонецЕсли;

	Если ТипЗнч(ЗначениеОшибки) = Тип("Массив") Тогда

		Возврат ИзвлечьТекстОшибкиИзJSONМассива(ЗначениеОшибки);

	КонецЕсли;

	Если ТипЗнч(ЗначениеОшибки) = Тип("Структура") Тогда

		Возврат ИзвлечьТекстОшибкиИзJSONСтруктуры(ЗначениеОшибки);

	КонецЕсли;

	Возврат "";

	

КонецФункции



Функция ИзвлечьТекстОшибкиИзJSONМассива(ЗначенияОшибки)

	

	Части = Новый Массив;

	Для Каждого Элемент Из ЗначенияОшибки Цикл

		ТекстЧасти = ИзвлечьТекстОшибкиИзJSONЗначения(Элемент);

		Если ЗначениеЗаполнено(ТекстЧасти) Тогда

			Части.Добавить(ТекстЧасти);

		КонецЕсли;

	КонецЦикла;

	Если Части.Количество() = 0 Тогда

		Возврат "";

	КонецЕсли;

	Возврат СтрСоединить(Части, "; ");

	

КонецФункции



Функция ИзвлечьТекстОшибкиИзJSONСтруктуры(ДанныеОшибки)

	

	Части = Новый Массив;

	Для Каждого Пара Из ДанныеОшибки Цикл

		ТекстЗначения = ИзвлечьТекстОшибкиИзJSONЗначения(Пара.Значение);

		Если ЗначениеЗаполнено(ТекстЗначения) Тогда

			Части.Добавить(Строка(Пара.Ключ) + ": " + ТекстЗначения);

		КонецЕсли;

	КонецЦикла;

	Если Части.Количество() = 0 Тогда

		Возврат "";

	КонецЕсли;

	Возврат СтрСоединить(Части, "; ");

	

КонецФункции



