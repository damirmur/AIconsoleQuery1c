КонецФункции

Функция ВерсияСловаря() Экспорт
	Возврат "1";
КонецФункции

Функция ОписаниеТипаСокращенно(ОписаниеТипов) Экспорт
	Если ОписаниеТипов = Неопределено Тогда Возврат "Неопределено"; КонецЕсли;
	Попытка
		Типы = ОписаниеТипов.Типы();
		Если Типы.Количество() = 0 Тогда Возврат "Неопределено"; КонецЕсли;
		СлТ = СловарьТипов();
		Части = Новый Массив;
		Для Каждого Т Из Типы Цикл
			ИмяТипа = Строка(Т);
			// Заменяем длинные имена типов на сокращения по словарю
			Для Каждого КЗ Из СлТ Цикл
				Если Найти(ИмяТипа, КЗ.Ключ) = 1 Тогда
					ИмяТипа = СтрЗаменить(ИмяТипа, КЗ.Ключ, КЗ.Значение);
					Прервать;
				ИначеЕсли Найти(ИмяТипа, КЗ.Ключ + ".") > 0 Тогда
					ИмяТипа = СтрЗаменить(ИмяТипа, КЗ.Ключ, КЗ.Значение);
				КонецЕсли;
			КонецЦикла;
			Части.Добавить(ИмяТипа);
		КонецЦикла;
		Стр = СтрСоединить(Части, ", ");
		Если ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
			Попытка Кв = ОписаниеТипов.КвалификаторыСтроки.Длина; Если Кв > 0 Тогда Стр = Стр + "(" + Кв + ")"; КонецЕсли; Исключение КонецПопытки;
		ИначеЕсли ОписаниеТипов.СодержитТип(Тип("Число")) Тогда
			Попытка КвЧ = ОписаниеТипов.КвалификаторыЧисла; Если КвЧ.Разрядность > 0 Тогда Стр = Стр + "(" + КвЧ.Разрядность + "," + КвЧ.РазрядностьДробнойЧасти + ")"; КонецЕсли; Исключение КонецПопытки;
		КонецЕсли;
		Возврат Стр;
	Исключение
		Возврат Строка(ОписаниеТипов);
	КонецПопытки;
КонецФункции

Функция ТекстСловаряДляИИ() Экспорт
	Возврат "Словарь префиксов: " + СловарьПрефиксовТекст() + Символы.ПС + "Словарь типов: " + СловарьТиповТекст() + " (пример: С(100)=Строка 100, Ч(10.2)=Число) ";
КонецФункции
#КонецОбласти

Функция СобратьТекстовуюСхемуМетаданных() Экспорт
	СтрСхема = "";
	Попытка
		СистИнфо = Новый СистемнаяИнформация;
		СтрСхема = СтрСхема + "Платформа: " + СистИнфо.ВерсияПриложения + Символы.ПС;
	Исключение
		СтрСхема = СтрСхема + "Платформа: ?" + Символы.ПС;
	КонецПопытки;
	Попытка
		СтрСхема = СтрСхема + "Конфигурация: " + Метаданные.Имя + " (" + Метаданные.Синоним + ") версия " + Метаданные.Версия + Символы.ПС;
	Исключение КонецПопытки;
	СтрСхема = СтрСхема + "Дата: " + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss") + Символы.ПС;
	Попытка
		Расш = СобратьВерсииРасширений();
		Если Расш.Количество() > 0 Тогда
			СтрСхема = СтрСхема + "Активные расширения: ";
			Для Каждого Р Из Расш Цикл
				СтрСхема = СтрСхема + Р.Имя + ":" + Р.Версия + "; ";
			КонецЦикла;
			СтрСхема = СтрСхема + Символы.ПС;
		Иначе
			СтрСхема = СтрСхема + "Активные расширения: нет" + Символы.ПС;
		КонецЕсли;
	Исключение КонецПопытки;
	СтрСхема = СтрСхема + "--- Схема метаданных (Реквизит:Тип) ---" + Символы.ПС;
	ПроцОбработать = Новый Массив;
	// Документы первыми — иначе при усечении 12К/413 Документы не доходят до ИИ (кейс "Путевой лист трактора")
	ПроцОбработать.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Документы, "Документ"));
	ПроцОбработать.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Справочники, "Справочник"));
	ПроцОбработать.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.РегистрыСведений, "РегистрСведений"));
	ПроцОбработать.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.РегистрыНакопления, "РегистрНакопления"));
	ПроцОбработать.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.РегистрыБухгалтерии, "РегистрБухгалтерии"));
	ПроцОбработать.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик"));
	ПроцОбработать.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Перечисления, "Перечисление"));
	ПроцОбработать.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.БизнесПроцессы, "БизнесПроцесс"));
	ПроцОбработать.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Задачи, "Задача"));
	Для Каждого Эл Из ПроцОбработать Цикл
		Колл = Эл.Коллекция; Преф = Эл.Префикс;
		Для Каждого ОбъектМД Из Колл Цикл
			Попытка
				СтрСхема = СтрСхема + Преф + "." + ОбъектМД.Имя + ": ";
				Поля = Новый Массив;
				Попытка
					Для Каждого Рекв Из ОбъектМД.Реквизиты Цикл
						Поля.Добавить(Рекв.Имя + ":" + ОписаниеТипаСтрокой(Рекв.Тип));
					КонецЦикла;
				Исключение КонецПопытки;
				Попытка
					Для Каждого Изм Из ОбъектМД.Измерения Цикл
						Поля.Добавить(Изм.Имя + ":" + ОписаниеТипаСтрокой(Изм.Тип));
					КонецЦикла;
				Исключение КонецПопытки;
				Попытка
					Для Каждого Рес Из ОбъектМД.Ресурсы Цикл
						Поля.Добавить(Рес.Имя + ":" + ОписаниеТипаСтрокой(Рес.Тип));
					КонецЦикла;
				Исключение КонецПопытки;
				Попытка
					Для Каждого Рекв Из ОбъектМД.РеквизитыАдреса Цикл
						Поля.Добавить(Рекв.Имя + ":" + ОписаниеТипаСтрокой(Рекв.Тип));
					КонецЦикла;
				Исключение КонецПопытки;
				Попытка
					Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
						ТЧПоля = Новый Массив;
						Для Каждого РК Из ТЧ.Реквизиты Цикл
							ТЧПоля.Добавить(РК.Имя + ":" + ОписаниеТипаСтрокой(РК.Тип));
						КонецЦикла;
						Поля.Добавить(ТЧ.Имя + "{" + СтрСоединить(ТЧПоля, ", ") + "}");
					КонецЦикла;
				Исключение КонецПопытки;
				Если Поля.Количество() > 0 Тогда
					СтрСхема = СтрСхема + СтрСоединить(Поля, ", ");
				Иначе
					СтрСхема = СтрСхема + "(нет реквизитов)";
				КонецЕсли;
				СтрСхема = СтрСхема + Символы.ПС;
				Если СтрДлина(СтрСхема) > 26000 Тогда
					СтрСхема = СтрСхема + "... (схема усечена до 26К, полный кэш в ХранилищеОбщихНастроек Current, лимит 413)" + Символы.ПС;
					Прервать;
				КонецЕсли;
			Исключение КонецПопытки;
		КонецЦикла;
		Если СтрДлина(СтрСхема) > 26000 Тогда Прервать; КонецЕсли;
	КонецЦикла;
	Возврат СтрСхема;
КонецФункции

Функция СобратьКраткийКаталог(Сокращенно = Истина) Экспорт
	// Сокращенно: Д./С./РС. + синоним оставляем
	Каталог = "";
	СлПреф = ?(Сокращенно, СловарьПрефиксов(), Неопределено);
	ПроцКаталог = Новый Массив;
	ПроцКаталог.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Документы, "Документ"));
	ПроцКаталог.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Справочники, "Справочник"));
	ПроцКаталог.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.РегистрыСведений, "РегистрСведений"));
	ПроцКаталог.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.РегистрыНакопления, "РегистрНакопления"));
	ПроцКаталог.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.РегистрыБухгалтерии, "РегистрБухгалтерии"));
	ПроцКаталог.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик"));
	ПроцКаталог.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Перечисления, "Перечисление"));
	ПроцКаталог.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.БизнесПроцессы, "БизнесПроцесс"));
	ПроцКаталог.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Задачи, "Задача"));
	Для Каждого Эл Из ПроцКаталог Цикл
		Колл = Эл.Коллекция; Преф = Эл.Префикс;
		СокрПреф = ?(Сокращенно И СлПреф <> Неопределено И СлПреф.Получить(Преф) <> Неопределено, СлПреф.Получить(Преф), Преф + ".");
		Для Каждого ОбъектМД Из Колл Цикл
			Попытка
				Каталог = Каталог + СокрПреф + ОбъектМД.Имя;
				Попытка Если ЗначениеЗаполнено(ОбъектМД.Синоним) Тогда Каталог = Каталог + " (" + ОбъектМД.Синоним + ")"; КонецЕсли; Исключение КонецПопытки;
				Каталог = Каталог + Символы.ПС;
			Исключение КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	Возврат Каталог;
КонецФункции

Функция ПолучитьДеталиОбъектов(МассивИмен, Сокращенно = Истина) Экспорт
	// МассивИмен: ["Документ.ПоступлениеТоваров","РегистрНакопления.ТоварыНаСкладах"] или сокращенные ["Д.ПоступлениеТоваров"]
	Если МассивИмен = Неопределено Или МассивИмен.Количество() = 0 Тогда Возврат ""; КонецЕсли;
	// Нормализуем: поддержка как полных, так и сокращенных имен
	СлПреф = СловарьПрефиксов();
	ОбратныйСл = Новый Соответствие;
	Для Каждого КЗ Из СлПреф Цикл ОбратныйСл.Вставить(НРег(КЗ.Значение), КЗ.Ключ); КонецЦикла;
	// карта сокращенное -> полное для поиска
	НормИмена = Новый Соответствие;
	Для Каждого Н Из МассивИмен Цикл
		Попытка
			Ч = СокрЛП(Н);
			ПозТоч = Найти(Ч, ".");
			Если ПозТоч > 0 Тогда
				ПрефЧасть = Лев(Ч, ПозТоч);
				ИмяЧасть = Сред(Ч, ПозТоч + 1);
				ПолныйПреф = ОбратныйСл.Получить(НРег(ПрефЧасть));
				Если ПолныйПреф <> Неопределено Тогда Ч = ПолныйПреф + "." + ИмяЧасть; КонецЕсли;
			КонецЕсли;
			НормИмена.Вставить(НРег(Ч), Истина);
			// также кладем сокращенный вариант для сравнения с СобратьКраткийКаталог
			НормИмена.Вставить(НРег(СокрЛП(Н)), Истина);
		Исключение КонецПопытки;
	КонецЦикла;
	Детали = "";
	Проц = Новый Массив;
	Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Документы, "Документ"));
	Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Справочники, "Справочник"));
	Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.РегистрыСведений, "РегистрСведений"));
	Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.РегистрыНакопления, "РегистрНакопления"));
	Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.РегистрыБухгалтерии, "РегистрБухгалтерии"));
	Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик"));
	Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Перечисления, "Перечисление"));
	Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.БизнесПроцессы, "БизнесПроцесс"));
	Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Задачи, "Задача"));
	Для Каждого Эл Из Проц Цикл
		Колл = Эл.Коллекция; Преф = Эл.Префикс;
		СокрПреф = ?(Сокращенно И СлПреф.Получить(Преф) <> Неопределено, СлПреф.Получить(Преф), Преф + ".");
		Для Каждого ОбъектМД Из Колл Цикл
			Полное = Преф + "." + ОбъектМД.Имя;
			СокрПолное = СокрПреф + ОбъектМД.Имя;
			Если Не (НормИмена.Получить(НРег(Полное)) = Истина Или НормИмена.Получить(НРег(СокрПолное)) = Истина) Тогда Продолжить; КонецЕсли;
			Попытка
				Стр = ?(Сокращенно, СокрПолное, Полное) + ": ";
				Поля = Новый Массив;
				Попытка Для Каждого Рекв Из ОбъектМД.Реквизиты Цикл Поля.Добавить(Рекв.Имя + ":" + ?(Сокращенно, ОписаниеТипаСокращенно(Рекв.Тип), ОписаниеТипаСтрокой(Рекв.Тип))); КонецЦикла; Исключение КонецПопытки;
				Попытка Для Каждого Изм Из ОбъектМД.Измерения Цикл Поля.Добавить(Изм.Имя + ":" + ?(Сокращенно, ОписаниеТипаСокращенно(Изм.Тип), ОписаниеТипаСтрокой(Изм.Тип))); КонецЦикла; Исключение КонецПопытки;
				Попытка Для Каждого Рес Из ОбъектМД.Ресурсы Цикл Поля.Добавить(Рес.Имя + ":" + ?(Сокращенно, ОписаниеТипаСокращенно(Рес.Тип), ОписаниеТипаСтрокой(Рес.Тип))); КонецЦикла; Исключение КонецПопытки;
				Попытка Для Каждого Рекв Из ОбъектМД.РеквизитыАдреса Цикл Поля.Добавить(Рекв.Имя + ":" + ?(Сокращенно, ОписаниеТипаСокращенно(Рекв.Тип), ОписаниеТипаСтрокой(Рекв.Тип))); КонецЦикла; Исключение КонецПопытки;
				Попытка Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
					ТЧПоля = Новый Массив; Для Каждого РК Из ТЧ.Реквизиты Цикл ТЧПоля.Добавить(РК.Имя + ":" + ?(Сокращенно, ОписаниеТипаСокращенно(РК.Тип), ОписаниеТипаСтрокой(РК.Тип))); КонецЦикла;
					Поля.Добавить(ТЧ.Имя + "{" + СтрСоединить(ТЧПоля, ", ") + "}");
				КонецЦикла; Исключение КонецПопытки;
				// Движения для ответа про проводки
				Попытка
					Движ = Новый Массив;
					Для Каждого Рег Из ОбъектМД.Движения Цикл
						Попытка Движ.Добавить(Строка(Рег.ПолноеИмя())); Исключение Попытка Движ.Добавить(Рег.Имя); Исключение КонецПопытки; КонецПопытки;
					КонецЦикла;
					Если Движ.Количество() > 0 Тогда Поля.Добавить("Движения: " + СтрСоединить(Движ, ", ")); КонецЕсли;
				Исключение КонецПопытки;
				Если Поля.Количество() > 0 Тогда Стр = Стр + СтрСоединить(Поля, ", "); Иначе Стр = Стр + "(нет реквизитов)"; КонецЕсли;
				Детали = Детали + Стр + Символы.ПС;
				Если СтрДлина(Детали) > 18000 Тогда Детали = Детали + "... (детали усечены 18К)" + Символы.ПС; Прервать; КонецЕсли;
			Исключение КонецПопытки;
		КонецЦикла;
		Если СтрДлина(Детали) > 18000 Тогда Прервать; КонецЕсли;
	КонецЦикла;
	Возврат Детали;
КонецФункции

Функция ПолучитьКонтекстСхемыДляИИ(ТекстЗапроса = "") Экспорт
	// LEGACY: оставлен для совместимости, теперь вызывает компакт+query-aware, но ОтправитьСообщение использует новые ПолучитьКонтекст* напрямую
	Возврат ПолучитьКонтекстСхемыКомпакт(ТекстЗапроса);
КонецФункции

Функция ПолучитьКонтекстСхемыКомпакт(ТекстЗапроса = "") Экспорт
	Попытка СистИнфо2 = Новый СистемнаяИнформация; Платф = СистИнфо2.ВерсияПриложения; Исключение Платф = "?"; КонецПопытки;
	Заголовок = "Ты — 1С:Напарник, помощник по запросам 1С. Платформа " + Платф + ", конфигурация " + Метаданные.Имя + " (" + Метаданные.Синоним + ") версия " + Метаданные.Версия + ", текущая дата " + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss") + ".";
	СловарьТекст = ТекстСловаряДляИИ();
	Инструкция = " ВАЖНО: Отвечай ТОЛЬКО на основе КРАТКОГО КАТАЛОГА ниже. ЗАПРЕЩЕНО вызывать Search_ITS/Fetch_ITS/FindSimilar_in_Project/GetProjects/ITS — сессии проекта нет. Не пиши 'Давайте поищем' в цикле. Каталог использует СОКРАЩЕНИЯ из словаря выше. Если для ответа нужны поля/реквизиты — верни РОВНО одну строку вида NEED: Д.Имя1, РС.Имя2 (сокращенные префиксы из словаря, через запятую) и я пришлю детали вторым сообщением. Если каталог уже покрывает вопрос — отвечай сразу без NEED. Не выдумывай объекты, не говори 'не существует' если имя есть в каталоге.";
	Каталог = СобратьКраткийКаталог(Истина);
	// query-aware приоритет: релевантные строки в начало
	Если ЗначениеЗаполнено(ТекстЗапроса) И СтрДлина(Каталог) > 8000 Тогда
		Попытка
			Ключи = Новый Массив;
			НКТ = НРег(ТекстЗапроса);
			Для Каждого Слово Из СтрРазделить(НКТ, " ,.;:" + Символы.ПС + Символы.Таб) Цикл Если СтрДлина(Слово) >= 3 Тогда Ключи.Добавить(Слово); КонецЕсли; КонецЦикла;
			Если Ключи.Количество() > 0 Тогда
				Строки = СтрРазделить(Каталог, Символы.ПС);
				Приор = Новый Массив; Остальн = Новый Массив;
				Для Каждого Стр Из Строки Цикл
					Если ПустаяСтрока(СокрЛП(Стр)) Тогда Продолжить; КонецЕсли;
					Низ = НРег(Стр);
					Попал = Ложь;
					Для Каждого К Из Ключи Цикл Если Найти(Низ, К) > 0 Тогда Попал = Истина; Прервать; КонецЕсли; КонецЦикла;
					Если Попал Тогда Приор.Добавить(Стр); Иначе Остальн.Добавить(Стр); КонецЕсли;
				КонецЦикла;
				Если Приор.Количество() > 0 Тогда
					Каталог = СтрСоединить(Приор, Символы.ПС) + Символы.ПС + СтрСоединить(Остальн, Символы.ПС);
					ЗаписатьЛогAether("ПолучитьКонтекстСхемыКомпакт приоритет: " + СтрСоединить(Ключи, ",") + " попали=" + Приор.Количество());
				КонецЕсли;
			КонецЕсли;
		Исключение КонецПопытки;
	КонецЕсли;
	Результат = Заголовок + Символы.ПС + СловарьТекст + Символы.ПС + Инструкция + Символы.ПС + "--- Краткий каталог (сокр., синонимы сохранены) ---" + Символы.ПС + Каталог;
	Если СтрДлина(Результат) > 16000 Тогда Результат = Лев(Результат, 16000) + Символы.ПС + "... (каталог усечен, полный в кэше)"; КонецЕсли;
	ЗаписатьЛогAether("ПолучитьКонтекстСхемыКомпакт: длина=" + СтрДлина(Результат) + " словарь v" + ВерсияСловаря() + " запрос=" + Лев(ТекстЗапроса, 80));
	Возврат Результат;
КонецФункции

Функция НайтиРелевантныеОбъектыПоЗапросу(ТекстЗапроса, Лимит = 8) Экспорт
	Результат = Новый Массив;
	Если ПустаяСтрока(ТекстЗапроса) Тогда Возврат Результат; КонецЕсли;
	Ключи = Новый Массив;
	НК = НРег(ТекстЗапроса);
	Для Каждого Слово Из СтрРазделить(НК, " ,.;:" + Символы.ПС + Символы.Таб) Цикл
		Если СтрДлина(Слово) >= 3 Тогда Ключи.Добавить(Слово); КонецЕсли;
	КонецЦикла;
	Если Ключи.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
	КаталогСтр = СобратьКраткийКаталог();
	Строки = СтрРазделить(КаталогСтр, Символы.ПС);
	Для Каждого Стр Из Строки Цикл
		Если ПустаяСтрока(СокрЛП(Стр)) Тогда Продолжить; КонецЕсли;
		Низ = НРег(Стр);
		Для Каждого К Из Ключи Цикл
			Если Найти(Низ, К) > 0 Тогда
				// вырезаем имя до пробела/скобки
				ПозПроб = Найти(Стр, " ");
				ПозСкоб = Найти(Стр, "(");
				Поз = 0;
				Если ПозПроб > 0 И ПозСкоб > 0 Тогда Поз = Мин(ПозПроб, ПозСкоб); ИначеЕсли ПозПроб > 0 Тогда Поз = ПозПроб; ИначеЕсли ПозСкоб > 0 Тогда Поз = ПозСкоб; КонецЕсли;
				Имя = ?(Поз > 0, СокрЛП(Лев(Стр, Поз - 1)), СокрЛП(Стр));
				Если Найти(Имя, ".") > 0 Тогда Результат.Добавить(Имя); КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Результат.Количество() >= Лимит Тогда Прервать; КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьКонтекстСхемыДетали(МассивИмен) Экспорт
	Попытка СистИнфо2 = Новый СистемнаяИнформация; Платф = СистИнфо2.ВерсияПриложения; Исключение Платф = "?"; КонецПопытки;
	Заголовок = "Детали по запросу NEED (Платформа " + Платф + ", " + Метаданные.Имя + " " + Метаданные.Версия + ") v" + ВерсияСловаря() + ":";
	СловарьТекст = ТекстСловаряДляИИ();
	Детали = ПолучитьДеталиОбъектов(МассивИмен, Истина);
	Если ПустаяСтрока(Детали) Тогда Детали = "(объекты не найдены: " + СтрСоединить(МассивИмен, ", ") + ")"; КонецЕсли;
	Результат = Заголовок + Символы.ПС + СловарьТекст + Символы.ПС + Детали;
	Если СтрДлина(Результат) > 18000 Тогда Результат = Лев(Результат, 18000) + Символы.ПС + "... (усечено)"; КонецЕсли;
	ЗаписатьЛогAether("ПолучитьКонтекстСхемыДетали: " + СтрСоединить(МассивИмен, ", ") + " длина=" + СтрДлина(Результат));
	Возврат Результат;
КонецФункции

