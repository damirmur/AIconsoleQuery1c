// Выполняет HTTP-запрос к API

// Параметры:

//  Путь - Строка - относительный путь API

//  Метод - Строка - HTTP-метод (GET, POST, PATCH)

//  Данные - Структура, Неопределено - данные для отправки в теле запроса (для POST/PATCH)

// Возвращаемое значение:

//  Структура - Ответ (Строка), Успех (Булево), Ошибка (Строка)


// Логирование Aether: файл КаталогВременныхФайлов/aether_debug.log + Сообщить
Функция ЗаписатьЛогAether(Текст) Экспорт
    Сообщить("[AetherLog] " + Текст);
    ЗаписьЖурналаРегистрации("AetherLog", УровеньЖурналаРегистрации.Информация, , , Текст);
    Попытка
        ИмяФайла = КаталогВременныхФайлов() + "aether_debug.log";
        ЗТ = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8, , Истина);
        ЗТ.ДобавитьСтроку(Формат(ТекущаяДата(), "ДФ=''yyyy-MM-dd HH:mm:ss''") + " | " + Текст);
        ЗТ.Закрыть();
    Исключение
    КонецПопытки;
    Попытка
        ЗТ2 = Новый ЗаписьТекста("C:\\Temp\\aether_debug.log", КодировкаТекста.UTF8, , Истина);
        ЗТ2.ДобавитьСтроку(Формат(ТекущаяДата(), "ДФ=''yyyy-MM-dd HH:mm:ss''") + " | " + Текст);
        ЗТ2.Закрыть();
    Исключение
    КонецПопытки;
    Возврат Истина;
КонецФункции

Функция ВыполнитьHTTPЗапрос(Путь, Метод, Данные = Неопределено)

	

	Результат = Новый Структура("Успех, Ответ, Ошибка", Ложь, "", "");

	

	ПараметрыAPI = ПолучитьПараметрыAPI();
	ЗаписатьЛогAether("HTTP ENTER " + Метод + " " + Путь + " host=" + ПараметрыAPI.Хост);

	

	Если ПараметрыAPI.ИспользоватьSSL Тогда

		Соединение = Новый HTTPСоединение(ПараметрыAPI.Хост, ПараметрыAPI.Порт,,,,, Новый ЗащищенноеСоединениеOpenSSL());

	Иначе

		Соединение = Новый HTTPСоединение(ПараметрыAPI.Хост, ПараметрыAPI.Порт);

	КонецЕсли;

	

	// Формирование запроса: 1c-buddy требует LLM_PROXY_KEY в X-API-Key/Bearer/?api_key (AGENTS.md:295, onec_gateway.go:106).

	// Путь уже содержит префикс /api/1c-buddy, шлюз срезает его stripBuddyPrefix.

	ЗапросПуть = Путь;

	// Fallback query param для совместимости с openai/authGuard (только Bearer/?api_key) — дублируем ключ в URL если нет заголовка на прокси

	Если Найти(ЗапросПуть, "?") = 0 Тогда

		ЗапросПуть = ЗапросПуть + "?api_key=" + КодироватьСтроку(ЭтотОбъект.ТокенДоступа, СпособКодированияСтроки.КодировкаURL);

	Иначе

		ЗапросПуть = ЗапросПуть + "&api_key=" + КодироватьСтроку(ЭтотОбъект.ТокенДоступа, СпособКодированияСтроки.КодировкаURL);

	КонецЕсли;

	Запрос = Новый HTTPЗапрос(ЗапросПуть);

	Запрос.Заголовки.Вставить("Content-Type", "application/json");

	// Дублируем во все поддерживаемые заголовки (balancer принимает любой, openai — только Bearer)

	Запрос.Заголовки.Вставить("X-API-Key", ЭтотОбъект.ТокенДоступа);

	Запрос.Заголовки.Вставить("X-LLM-Proxy-Key", ЭтотОбъект.ТокенДоступа);

	Запрос.Заголовки.Вставить("Authorization", "Bearer " + ЭтотОбъект.ТокенДоступа);

	// Для запросов с телом добавляем JSON-данные

	Если (Метод = "POST" Или Метод = "PATCH") И Данные <> Неопределено Тогда

		Запрос.УстановитьТелоИзСтроки(СформироватьJSON(Данные));
	ЗаписатьЛогAether("HTTP body " + Метод + " " + Путь + " : " + Лев(СформироватьJSON(Данные), 800));

	КонецЕсли;

	

	// Выполнение запроса

	Попытка

		ЗаписатьЛогAether("HTTP " + Метод + " https://" + ПараметрыAPI.Хост + ":" + ПараметрыAPI.Порт + Путь + " | токен=" + Лев(ПараметрыAPI.ТокенДоступа,6) + "...");
		Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
		ЗаписатьЛогAether("HTTP ответ " + Метод + " " + Путь + " -> " + Ответ.КодСостояния + " | тело=" + Лев(Ответ.ПолучитьТелоКакСтроку(), 800));

		

		// Обработка кодов ответа

		Если Ответ.КодСостояния = 200 Или Ответ.КодСостояния = 201 Или Ответ.КодСостояния = 204 Тогда

			Результат.Успех = Истина;

			Результат.Ответ = Ответ.ПолучитьТелоКакСтроку();

		ИначеЕсли Ответ.КодСостояния = 401 Тогда

			Результат.Ошибка = "Ошибка авторизации (401 Unauthorized)";

		ИначеЕсли Ответ.КодСостояния = 404 Тогда

			Результат.Ошибка = "Ресурс не найден (404 Not Found)";
		ИначеЕсли Ответ.КодСостояния = 502 Тогда
			Результат.Ошибка = "Сервер ИИ временно недоступен (502 Bad Gateway). Повторите позже. Апстрим code.1c.ai недоступен (AGENTS.md:324). Тело: " + Лев(Ответ.ПолучитьТелоКакСтроку(), 500);
			ЗаписатьЛогAether("502 Bad Gateway for " + Путь + " -> " + Лев(Ответ.ПолучитьТелоКакСтроку(), 300));

		Иначе

			ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();

			ТекстОшибки = ИзвлечьДетальОшибкиИзJsonОтветаAPI(ТелоОтвета);

			Если ПустаяСтрока(ТекстОшибки) Тогда

				Результат.Ошибка = СтрШаблон("Ошибка API: код %1, ответ: %2", Ответ.КодСостояния, ТелоОтвета);

			Иначе

				Результат.Ошибка = ТекстОшибки;

			КонецЕсли;

		КонецЕсли;

		

	Исключение
		Результат.Ошибка = "Ошибка выполнения запроса: " + ОписаниеОшибки();

	КонецПопытки;

	

	Возврат Результат;

	

КонецФункции



// Возвращает параметры подключения к API для выбранного окружения.

Функция ПолучитьПараметрыAPI() Экспорт

	

	// Миграция на 1c-buddy: единый хост astro3d.ru, префикс /api/1c-buddy срезается шлюзом (см. AGENTS.md:288).

	// LLM_PROXY_KEY хранится в ТокенДоступа, заголовок X-API-Key + Bearer (AGENTS.md:295).

	ОкружениеAPI = "prod";

	

	Если ОкружениеAPI = "prod" Тогда

		Возврат Новый Структура("Хост, Порт, ИспользоватьSSL, ТокенДоступа", "astro3d.ru", 443, Истина, ЭтотОбъект.ТокенДоступа);

	ИначеЕсли ОкружениеAPI = "local" Тогда

		Возврат Новый Структура("Хост, Порт, ИспользоватьSSL, ТокенДоступа", "192.168.2.206", 8000, Ложь, ЭтотОбъект.ТокенДоступа); // 127.0.0.1

	КонецЕсли;

	

	Возврат Новый Структура("Хост, Порт, ИспользоватьSSL, ТокенДоступа", "astro3d.ru", 443, Истина, ЭтотОбъект.ТокенДоступа);

	

КонецФункции



