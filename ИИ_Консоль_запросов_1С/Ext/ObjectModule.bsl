	Сл.Вставить("Документ", "Д.");
	Сл.Вставить("Справочник", "С.");
	Сл.Вставить("РегистрСведений", "РС.");
	Сл.Вставить("РегистрНакопления", "РН.");
	Сл.Вставить("РегистрБухгалтерии", "РБ.");
	Сл.Вставить("ПланВидовХарактеристик", "ПВХ.");
	Сл.Вставить("Перечисление", "П.");
	Сл.Вставить("БизнесПроцесс", "БП.");
	Сл.Вставить("Задача", "З.");
	Возврат Сл;
КонецФункции

