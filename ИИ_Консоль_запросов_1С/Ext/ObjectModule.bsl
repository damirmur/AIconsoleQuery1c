// MCP: вызов check_1c_code через /mcp (AGENTS.md:311). Требует 2 шага: initialize + tools/call

// Упрощенный статический путь: шлюз проксирует tools/call напрямую без сессии, но пробуем Streamable HTTP

Функция Buddy_ПроверитьКод(Код, ТипПроверки = "syntax") Экспорт

	// ТипПроверки: syntax|review (AGENTS.md:313)

	Путь = Buddy_Префикс() + "/mcp";

	// 1. initialize

	ДанныеInit = Новый Структура;

	ДанныеInit.Вставить("jsonrpc", "2.0");

	ДанныеInit.Вставить("id", 1);

	ДанныеInit.Вставить("method", "initialize");

	Параметры = Новый Структура;

	Параметры.Вставить("protocolVersion", "2024-11-05");

	Параметры.Вставить("capabilities", Новый Структура);

	Параметры.Вставить("clientInfo", Новый Структура("name, version", "1C-QueryConsole", ВерсияОбъекта()));

	ДанныеInit.Вставить("params", Параметры);

	РезультатInit = ВыполнитьHTTPЗапрос(Путь, "POST", ДанныеInit);

	// Если initialize не нужен (шлюз проксирует без сессии), сразу пробуем tools/call

	ДанныеCall = Новый Структура;

	ДанныеCall.Вставить("jsonrpc", "2.0");

	ДанныеCall.Вставить("id", 2);

	ДанныеCall.Вставить("method", "tools/call");

	ПараметрыCall = Новый Структура;

	ПараметрыCall.Вставить("name", "check_1c_code");

	Аргументы = Новый Структура;

	Аргументы.Вставить("code", Код);

	Аргументы.Вставить("check_type", ТипПроверки);

	ПараметрыCall.Вставить("arguments", Аргументы);

	ДанныеCall.Вставить("params", ПараметрыCall);

	РезультатCall = ВыполнитьHTTPЗапрос(Путь, "POST", ДанныеCall);

	Если РезультатCall.Успех Тогда

		Попытка

			ОтветJSON = ПрочитатьJSONИзСтроки(РезультатCall.Ответ);

			Возврат Новый Структура("Успех, Данные, Ответ, Ошибка", Истина, ОтветJSON, РезультатCall.Ответ, "");

		Исключение

			Возврат Новый Структура("Успех, Ответ, Ошибка", Истина, РезультатCall.Ответ, "");

		КонецПопытки;

	КонецЕсли;

	Возврат Новый Структура("Успех, Ошибка", Ложь, РезультатCall.Ошибка);

КонецФункции



