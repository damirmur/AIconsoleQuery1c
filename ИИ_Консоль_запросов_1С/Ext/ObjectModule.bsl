Функция СобратьВерсииРасширений() Экспорт
	Результат = Новый Массив;
	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			// Только активные расширения (п.5)
			Активно = Ложь;
			Попытка
				Активно = Расширение.Активно;
			Исключение
				Попытка
					Активно = Расширение.Активность;
				Исключение
					Активно = Истина;
				КонецПопытки;
			КонецПопытки;
			Если Не Активно Тогда
				Продолжить;
			КонецЕсли;
			СтруктураРасширения = Новый Структура;
			СтруктураРасширения.Вставить("Имя", Расширение.Имя);
			СтруктураРасширения.Вставить("Версия", Расширение.Версия);
			СтруктураРасширения.Вставить("Активно", Активно);
			Результат.Добавить(СтруктураРасширения);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Результат;
КонецФункции



Функция ВычислитьХешСхемы(ВерсияКонфигурации = "") Экспорт

	// Простой хеш: Версия + список расширений + версия словаря. Для полноценного — хеш сжатого XML.

	СтрокаДляХеша = Строка(ВерсияКонфигурации) + "|" + Строка(Метаданные.Версия) + "|" + ВерсияСловаря();
	Расширения = СобратьВерсииРасширений();
	// сортировка по имени для детерминизма хеша
	Попытка
		Для i = 0 По Расширения.Количество() - 2 Цикл
			Для j = i + 1 По Расширения.Количество() - 1 Цикл
				Если Расширения[i].Имя > Расширения[j].Имя Тогда
					Вр = Расширения[i]; Расширения[i] = Расширения[j]; Расширения[j] = Вр;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение КонецПопытки;
	Для Каждого Эл Из Расширения Цикл
		СтрокаДляХеша = СтрокаДляХеша + "|" + Эл.Имя + ":" + Эл.Версия;
	КонецЦикла;

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);

	Хеширование.Добавить(СтрокаДляХеша);

	Возврат СтрЗаменить(Строка(Хеширование.ХешСумма), " ", "");

КонецФункции

Функция КэшМетаданных_Актуален() Экспорт
	Попытка
		Сохр = ХранилищеОбщихНастроек.Загрузить(КэшМетаданных_КлючОбъекта(), КэшМетаданных_КлючНастроекCurrent());
		Если Сохр = Неопределено Тогда
			ЗаписатьЛогAether("КэшМетаданных_Актуален: пусто (первый запуск)");
			Возврат Ложь;
		КонецЕсли;
		Если Не Сохр.Свойство("ХешСхемы") Тогда
			ЗаписатьЛогAether("КэшМетаданных_Актуален: нет ХешСхемы");
			Возврат Ложь;
		КонецЕсли;
		ТекущийХеш = ВычислитьХешСхемы(Метаданные.Версия);
		Рез = Сохр.ХешСхемы = ТекущийХеш;
		Если Не Рез Тогда
			ЗаписатьЛогAether("КэшМетаданных_Актуален: хеш не совпал сохр=" + Сохр.ХешСхемы + " текущ=" + ТекущийХеш);
		Иначе
			ЗаписатьЛогAether("КэшМетаданных_Актуален: хеш совпал " + ТекущийХеш);
		КонецЕсли;
		Возврат Рез;
	Исключение
		ЗаписатьЛогAether("КэшМетаданных_Актуален искл: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция КэшМетаданных_Есть() Экспорт
	Попытка
		Сохр = ХранилищеОбщихНастроек.Загрузить(КэшМетаданных_КлючОбъекта(), КэшМетаданных_КлючНастроекCurrent());
		Возврат Сохр <> Неопределено;
	Исключение
