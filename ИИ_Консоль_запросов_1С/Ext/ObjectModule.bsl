// Отправляет сообщение в сессию

// Параметры:

//  СсылкаСессии - Строка - UUID сессии

//  ТекстСообщения - Строка - текст сообщения

// Возвращаемое значение:

//  Структура - результат запроса: Успех (Булево), Ошибка (Строка)

Функция ОтправитьСообщение(СсылкаСессии, ТекстСообщения, ТекущийЗапрос) Экспорт
    МаксимальнаяДлинаСообщения = 10000;
    Если СтрДлина(Строка(ТекстСообщения)) > МаксимальнаяДлинаСообщения Тогда
        Возврат Новый Структура("Успех, Ошибка", Ложь, "Сообщение слишком длинное: максимум 10000 символов.");
    КонецЕсли;
    Если мИсторияБадди = Неопределено Тогда
        мИсторияБадди = Новый Массив;
    КонецЕсли;
    ТекстДляБадди = ТекстСообщения;
    Если ЗначениеЗаполнено(ТекущийЗапрос) Тогда
        ТекстДляБадди = ТекстДляБадди + Символы.ПС + "Запрос:" + Символы.ПС + ТекущийЗапрос;
    КонецЕсли;
    // Загружаем историю для окна LLM (stateless, но контекст нужен)
    Попытка
        Сохр = ХранилищеОбщихНастроек.Загрузить("BuddyHistory", СсылкаСессии);
        Если Сохр <> Неопределено Тогда
            мИсторияБадди = Сохр;
        КонецЕсли;
    Исключение КонецПопытки;
    // V2: compact → NEED → детали + история (2×200 OK stateless)
    КонтекстКомпакт = "";
    Попытка КонтекстКомпакт = ПолучитьКонтекстСхемыКомпакт(ТекстДляБадди); Исключение КонтекстКомпакт = ""; КонецПопытки;
    ИсторияДляLLM = Новый Массив;
    Попытка
        Для Каждого Эл Из мИсторияБадди Цикл
            // отбор только user/assistant для LLM (последние 12 обрежутся в Buddy_Спросить)
            Если Эл.role = "user" Или Эл.role = "assistant" Тогда
                ИсторияДляLLM.Добавить(Новый Структура("role, text", Эл.role, Эл.text));
            КонецЕсли;
        КонецЦикла;
    Исключение КонецПопытки;
    РезультатБадди = Buddy_Спросить(ТекстДляБадди, КонтекстКомпакт, "", ИсторияДляLLM);
    Если Не РезультатБадди.Успех Тогда
        Возврат Новый Структура("Успех, Ошибка", Ложь, РезультатБадди.Ошибка);
    КонецЕсли;
    ТекстОтвета = РезультатБадди.ТекстОтвета;
    // Проверка NEED: Документ.Имя, Регистр... — второй вызов с деталями + fallback на локальный поиск при цикле ITS
    Попытка
        Поз = Найти(ВРег(ТекстОтвета), "NEED:");
        МассивИмен = Неопределено;
        РежимFallback = Ложь;
        Если Поз > 0 Тогда
            СтрNeed = Сред(ТекстОтвета, Поз + 5);
            ПозПС = Найти(СтрNeed, Символы.ПС);
            Если ПозПС > 0 Тогда СтрNeed = Лев(СтрNeed, ПозПС - 1); КонецЕсли;
            МассивИмен = Новый Массив;
            Для Каждого Ч Из СтрРазделить(СтрNeed, ",") Цикл
                Имя = СокрЛП(СтрЗаменить(Ч, ";", ""));
                Если Найти(Имя, ".") > 0 И СтрДлина(Имя) >= 3 Тогда МассивИмен.Добавить(Имя); КонецЕсли;
            КонецЦикла;
            Если МассивИмен.Количество() = 0 Тогда МассивИмен = Неопределено; КонецЕсли;
        Иначе
            // Fallback: LLM не вернул NEED, но ушёл в цикл / галлюцинацию — ищем локально
            НизОтвета = НРег(ТекстОтвета);
            Если Найти(НизОтвета, "давайте поищем") > 0 Или Найти(НизОтвета, "its knowledge") > 0 Или Найти(НизОтвета, "session_id") > 0 Или Найти(НизОтвета, "findsimilar") > 0 Или Найти(НизОтвета, "отсутств") > 0 Или Найти(НизОтвета, "не существует") > 0 Или Найти(НизОтвета, "нет в каталоге") > 0 Тогда
                РежимFallback = Истина;
                ЗаписатьЛогAether("ОтправитьСообщение V2 fallback loop detect, ищем локально по запросу: " + Лев(ТекстДляБадди, 120));
                МассивИмен = НайтиРелевантныеОбъектыПоЗапросу(ТекстДляБадди, 8);
                Если МассивИмен.Количество() = 0 Тогда МассивИмен = Неопределено; КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        Если МассивИмен <> Неопределено И МассивИмен.Количество() > 0 Тогда
            // Разворачиваем generic NEED: РБ./РН. и чистим .Модуль
            Попытка
                Развернутые = Новый Массив;
                Для Каждого Имя Из МассивИмен Цикл
                    Чист = СокрЛП(Имя);
                    Если Прав(Чист, 7) = ".Модуль" Тогда Чист = Лев(Чист, СтрДлина(Чист) - 7); КонецЕсли;
                    Если Чист = "РБ." Или Чист = "РН." Или Чист = "РС." Или Чист = "Д." Или Чист = "С." Тогда
                        // generic префикс → все объекты этого типа
                        Кат = СобратьКраткийКаталог(Истина);
                        Для Каждого Стр Из СтрРазделить(Кат, Символы.ПС) Цикл
                            Если ПустаяСтрока(СокрЛП(Стр)) Тогда Продолжить; КонецЕсли;
                            Если Лев(НРег(СокрЛП(Стр)), СтрДлина(Чист)) = НРег(Чист) Тогда
                                ПозПроб = Найти(Стр, " "); ПозСкоб = Найти(Стр, "("); Поз = 0;
                                Если ПозПроб > 0 И ПозСкоб > 0 Тогда Поз = Мин(ПозПроб, ПозСкоб); ИначеЕсли ПозПроб > 0 Тогда Поз = ПозПроб; ИначеЕсли ПозСкоб > 0 Тогда Поз = ПозСкоб; КонецЕсли;
                                Имя2 = ?(Поз > 0, СокрЛП(Лев(Стр, Поз - 1)), СокрЛП(Стр));
                                Если Найти(Имя2, ".") > 0 Тогда Развернутые.Добавить(Имя2); КонецЕсли;
                                Если Развернутые.Количество() >= 8 Тогда Прервать; КонецЕсли;
                            КонецЕсли;
                        КонецЦикла;
                    Иначе
                        Развернутые.Добавить(Чист);
                    КонецЕсли;
                КонецЦикла;
                МассивИмен = Развернутые;
            Исключение КонецПопытки;
            ЗаписатьЛогAether("ОтправитьСообщение V2 " + ?(РежимFallback, "FALLBACK", "NEED") + ": " + СтрСоединить(МассивИмен, ", "));
            Если МассивИмен.Количество() > 8 Тогда Пока МассивИмен.Количество() > 8 Цикл МассивИмен.Удалить(8); КонецЦикла; КонецЕсли;
            Если МассивИмен.Количество() = 0 Тогда
                ЗаписатьЛогAether("ОтправитьСообщение V2 generic NEED дал 0 — пропускаем второй вызов");
            Иначе
                КонтекстДетали = "";
                Попытка КонтекстДетали = ПолучитьКонтекстСхемыДетали(МассивИмен); Исключение КонтекстДетали = ""; КонецПопытки;
            ИсторияВторой = Новый Массив;
            Для Каждого Э Из ИсторияДляLLM Цикл ИсторияВторой.Добавить(Э); КонецЦикла;
            ИсторияВторой.Добавить(Новый Структура("role, text", "user", ТекстДляБадди));
            ИсторияВторой.Добавить(Новый Структура("role, text", "assistant", ТекстОтвета));
            ТекстВторой = ?(РежимFallback, "Ты ушёл в поиск ITS/цикл — игнорируй. ", "") + "Детали по " + ?(РежимFallback, "локальному поиску", "NEED") + " ниже. Сформируй итоговый ответ (запрос/исправленный запрос + пояснение) на основе деталей. Исходный вопрос: " + ТекстДляБадди;
            РезультатВторой = Buddy_Спросить(ТекстВторой, КонтекстДетали, "", ИсторияВторой);
            Если РезультатВторой.Успех Тогда
                ТекстОтвета = РезультатВторой.ТекстОтвета;
                ЗаписатьЛогAether("ОтправитьСообщение V2 второй вызов OK длина=" + СтрДлина(ТекстОтвета));
            Иначе
                ЗаписатьЛогAether("ОтправитьСообщение V2 второй вызов ошибка: " + РезультатВторой.Ошибка);
            КонецЕсли;
            КонецЕсли;
        КонецЕсли;
    Исключение
        ЗаписатьЛогAether("ОтправитьСообщение V2 NEED parse искл: " + ОписаниеОшибки());
    КонецПопытки;
    ЗаписьПольз = Новый Структура("ID, role, text, created_at, is_user, query, query_text", Строка(Новый УникальныйИдентификатор), "user", ТекстСообщения, ТекущаяДата(), Истина, "", "");
    Если ЗначениеЗаполнено(ТекущийЗапрос) Тогда
        ЗаписьПольз.query = ТекущийЗапрос;
        ЗаписьПольз.query_text = ТекущийЗапрос;
    КонецЕсли;
    мИсторияБадди.Добавить(ЗаписьПольз);
    мИсторияБадди.Добавить(Новый Структура("ID, role, text, created_at, is_user, query, query_text", Строка(Новый УникальныйИдентификатор), "assistant", ТекстОтвета, ТекущаяДата(), Ложь, "", ""));
    Попытка
        ХранилищеОбщихНастроек.Сохранить("BuddyHistory", СсылкаСессии, мИсторияБадди);
    Исключение
    КонецПопытки;
    Возврат Новый Структура("Успех, Ошибка", Истина, "");

	

КонецФункции



// Получает историю сообщений сессии

// Параметры:

//  СсылкаСессии - Строка - UUID сессии

// Возвращаемое значение:

//  Структура - результат запроса: Данные (Массив), Успех (Булево), Ошибка (Строка)

Функция ПолучитьИсториюСессии(СсылкаСессии) Экспорт
    Попытка
        Сохр = ХранилищеОбщихНастроек.Загрузить("BuddyHistory", СсылкаСессии);
        Если Сохр <> Неопределено И Сохр.Количество() > 0 Тогда
            мИсторияБадди = Сохр;
            Данные = Новый Структура("count, results", мИсторияБадди.Количество(), мИсторияБадди);
            Возврат Новый Структура("Успех, Данные, Ошибка", Истина, Данные, "");
        КонецЕсли;
    Исключение
    КонецПопытки;
    Если мИсторияБадди <> Неопределено И мИсторияБадди.Количество() > 0 Тогда
        Данные = Новый Структура("count, results", мИсторияБадди.Количество(), мИсторияБадди);
        Возврат Новый Структура("Успех, Данные, Ошибка", Истина, Данные, "");
    КонецЕсли;
    // Buddy stateless: не ходим в manager-1c (502), возвращаем пусто или кэш
    Данные = Новый Структура("count, results", 0, Новый Массив);
    Возврат Новый Структура("Успех, Данные, Ошибка", Истина, Данные, "");

	

КонецФункции  



