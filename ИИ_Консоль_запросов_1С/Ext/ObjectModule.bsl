// Сохраняет актуальные метаданные (сжатые) с перезаписью. JSON вместо XML (~10x меньше)

Функция КэшМетаданных_Сохранить(ДанныеИлиJSON, ВерсияКонфигурации = "", ХешСхемы = "") Экспорт

	Попытка
		Если ТипЗнч(ДанныеИлиJSON) = Тип("Строка") Тогда
			Сжатые = Новый ХранилищеЗначения(ДанныеИлиJSON, Новый СжатиеДанных(9));
			Формат = "json";
		Иначе
			Сжатые = Новый ХранилищеЗначения(ДанныеИлиJSON, Новый СжатиеДанных(9));
			Формат = "xml";
		КонецЕсли;
		СтруктураСохранения = Новый Структура;
		СтруктураСохранения.Вставить("ВерсияКонфигурации", Строка(ВерсияКонфигурации));
		СтруктураСохранения.Вставить("ХешСхемы", Строка(ХешСхемы));
		СтруктураСохранения.Вставить("ДатаВыгрузки", ТекущаяДата());
		СтруктураСохранения.Вставить("Формат", Формат);
		Если Формат = "json" Тогда
			СтруктураСохранения.Вставить("СжатыйJSON", Сжатые);
			СтруктураСохранения.Вставить("СжатыйXML", Неопределено);
		Иначе
			СтруктураСохранения.Вставить("СжатыйXML", Сжатые);
		КонецЕсли;
		СтруктураСохранения.Вставить("ВерсииРасширений", СобратьВерсииРасширений());
		Попытка
			СистИнфо1 = Новый СистемнаяИнформация;
			Платф1 = СистИнфо1.ВерсияПриложения;
		Исключение
			Платф1 = "";
		КонецПопытки;
		СтруктураСохранения.Вставить("ПлатформаВерсия", Платф1);
		СтруктураСохранения.Вставить("ИмяКонфигурации", Метаданные.Имя);
		СтруктураСохранения.Вставить("СинонимКонфигурации", Метаданные.Синоним);
		// Словарь v1 + компакт каталог сокр. (для быстрой отдачи без обхода Метаданные.*)
		Попытка
			СтруктураСохранения.Вставить("ВерсияСловаря", ВерсияСловаря());
			СтруктураСохранения.Вставить("КомпактКаталогСокр", СобратьКраткийКаталог(Истина));
		Исключение КонецПопытки;
		ХранилищеОбщихНастроек.Сохранить(КэшМетаданных_КлючОбъекта(), КэшМетаданных_КлючНастроекCurrent(), СтруктураСохранения);
		Возврат Новый Структура("Успех, Ошибка", Истина, "");
	Исключение
		Возврат Новый Структура("Успех, Ошибка", Ложь, ОписаниеОшибки());
	КонецПопытки;

КонецФункции



Функция КэшМетаданных_Загрузить() Экспорт

	Попытка

		СтруктураСохранения = ХранилищеОбщихНастроек.Загрузить(КэшМетаданных_КлючОбъекта(), КэшМетаданных_КлючНастроекCurrent());

		Если СтруктураСохранения = Неопределено Тогда

			Возврат Новый Структура("Успех, Данные, Ошибка", Ложь, Неопределено, "Кэш пуст");

		КонецЕсли;

		Формат = "";
		Попытка Формат = СтруктураСохранения.Формат; Исключение КонецПопытки;
		Сжатые = Неопределено;
		Если Формат = "json" Тогда
			Попытка Сжатые = СтруктураСохранения.СжатыйJSON; Исключение КонецПопытки;
		Иначе
			Попытка Сжатые = СтруктураСохранения.СжатыйXML; Исключение КонецПопытки;
			Если Сжатые = Неопределено Тогда Попытка Сжатые = СтруктураСохранения.СжатыйJSON; Исключение КонецПопытки; КонецЕсли;
		КонецЕсли;

		Если ТипЗнч(Сжатые) = Тип("ХранилищеЗначения") Тогда

			Данные = Сжатые.Получить();

		Иначе

			Данные = Сжатые;

		КонецЕсли;

		Возврат Новый Структура("Успех, Данные, Структура, Ошибка", Истина, Данные, СтруктураСохранения, "");

	Исключение

		Возврат Новый Структура("Успех, Ошибка", Ложь, ОписаниеОшибки());

	КонецПопытки;

КонецФункции



