// Универсальный вызов OpenAI-совместимого API 1c-buddy

// Параметры: Сообщения - Массив структур {role, content}, Stream - Булево, ConversationId - Строка (metadata.conversation_id)

// Возврат: Структура Успех, Данные, Ответ, Ошибка

Функция Buddy_ChatCompletions(Сообщения, Stream = Ложь, ConversationId = "") Экспорт

	Путь = Buddy_Префикс() + "/v1/chat/completions";

	Данные = Новый Структура;

	Данные.Вставить("model", "1c-buddy");

	Данные.Вставить("messages", Сообщения);

	Данные.Вставить("stream", Stream);

	Если ЗначениеЗаполнено(ConversationId) Тогда

		Мета = Новый Структура;

		Мета.Вставить("conversation_id", Строка(ConversationId));

		Данные.Вставить("metadata", Мета);

	КонецЕсли;

	Результат = ВыполнитьHTTPЗапрос(Путь, "POST", Данные);

	Если Результат.Успех Тогда

		Если ПустаяСтрока(Результат.Ответ) Тогда

			Возврат Новый Структура("Успех, Данные, Ошибка", Истина, Новый Структура, "");

		КонецЕсли;

		Попытка

			ОтветJSON = ПрочитатьJSONИзСтроки(Результат.Ответ);

			Возврат Новый Структура("Успех, Данные, Ответ, Ошибка", Истина, ОтветJSON, Результат.Ответ, "");

		Исключение

			Возврат Новый Структура("Успех, Данные, Ответ, Ошибка", Истина, Новый Структура, Результат.Ответ, "");

		КонецПопытки;

	КонецЕсли;

	// Детализация 500/502 для 1c-buddy (AGENTS.md:324): 500 — нет ONEC_AI_TOKEN, 502 — апстрим code.1c.ai недоступен

	Доп = "";

	Если Найти(Результат.Ошибка, "500") > 0 Тогда

		Доп = " (сервер 1c-buddy: нет ONEC_AI_TOKEN)";

	ИначеЕсли Найти(Результат.Ошибка, "502") > 0 Тогда

		Доп = " (апстрим code.1c.ai недоступен)";

	КонецЕсли;

	Возврат Новый Структура("Успех, Ошибка", Ложь, Результат.Ошибка + Доп);

КонецФункции



// Простой запрос к LLM: Сообщения -> текст ответа
// История — Массив структур {role,text} для окна last N (stateless, без conversation_id)

Функция Buddy_Спросить(ТекстЗапроса, КонтекстСхемы = "", ConversationId = "", ИсторияДляLLM = Неопределено) Экспорт

	Сообщения = Новый Массив;

	Если ЗначениеЗаполнено(КонтекстСхемы) Тогда

		Сообщения.Добавить(Новый Структура("role, content", "system", КонтекстСхемы));

	КонецЕсли;

	// Окно истории: последние 6 пар (12 сообщений), обрезка до 2000 симв каждое чтобы уложиться в 413/токены
	Если ИсторияДляLLM <> Неопределено И ИсторияДляLLM.Количество() > 0 Тогда
		Нач = Макс(0, ИсторияДляLLM.Количество() - 12);
		Для Инд = Нач По ИсторияДляLLM.Количество() - 1 Цикл
			Эл = ИсторияДляLLM[Инд];
			Попытка
				Роль = Эл.role; Текст = Эл.text;
				Если Роль = "user" Или Роль = "assistant" Тогда
					Если СтрДлина(Текст) > 2000 Тогда Текст = Лев(Текст, 2000) + " ... (обрезано)"; КонецЕсли;
					Сообщения.Добавить(Новый Структура("role, content", Роль, Текст));
				КонецЕсли;
			Исключение КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	Сообщения.Добавить(Новый Структура("role, content", "user", ТекстЗапроса));

	Результат = Buddy_ChatCompletions(Сообщения, Ложь, ConversationId);

	Если Не Результат.Успех Тогда

		Возврат Новый Структура("Успех, ТекстОтвета, Ошибка", Ложь, "", Результат.Ошибка);

	КонецЕсли;

	Попытка

		ТекстОтвета = Результат.Данные.choices[0].message.content;

		Возврат Новый Структура("Успех, ТекстОтвета, Ошибка", Истина, Строка(ТекстОтвета), "");

	Исключение

		// fallback на raw Ответ

		Возврат Новый Структура("Успех, ТекстОтвета, Ошибка", Истина, Строка(Результат.Ответ), "");

	КонецПопытки;

КонецФункции



// Проверка моделей (диагностика)

Функция Buddy_ПроверитьДоступность() Экспорт

	Путь = Buddy_Префикс() + "/v1/models";

	Результат = ВыполнитьHTTPЗапрос(Путь, "GET");

