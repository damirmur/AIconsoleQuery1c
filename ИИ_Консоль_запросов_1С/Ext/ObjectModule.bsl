	КонецПопытки;
КонецФункции

Функция КэшМетаданных_ОбеспечитьАктуальность() Экспорт
	Если КэшМетаданных_Актуален() Тогда
		Возврат Новый Структура("Успех, Актуален, Ошибка", Истина, Истина, "");
	КонецЕсли;
	Попытка
		JSONСтрока = СобратьJSONСхему();
		Если ПустаяСтрока(JSONСтрока) Тогда
			Возврат Новый Структура("Успех, Ошибка", Ложь, "СобратьJSONСхему вернула пусто");
		КонецЕсли;
		Хеш = ВычислитьХешСхемы(Метаданные.Версия);
		Рез = КэшМетаданных_Сохранить(JSONСтрока, Метаданные.Версия, Хеш);
		Если Рез.Успех Тогда
			ЗаписатьЛогAether("КэшМетаданных_ОбеспечитьАктуальность JSON длина=" + СтрДлина(JSONСтрока) + " хеш=" + Хеш);
			Возврат Новый Структура("Успех, Актуален, Ошибка", Истина, Ложь, "");
		Иначе
			Возврат Новый Структура("Успех, Ошибка", Ложь, Рез.Ошибка);
		КонецЕсли;
	Исключение
		Возврат Новый Структура("Успех, Ошибка", Ложь, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ОписаниеТипаСтрокой(ОписаниеТипов) Экспорт
	Если ОписаниеТипов = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;
	Попытка
		Типы = ОписаниеТипов.Типы();
		Если Типы.Количество() = 0 Тогда
			Возврат "Неопределено";
		КонецЕсли;
		Части = Новый Массив;
		Для Каждого Т Из Типы Цикл
			Части.Добавить(Строка(Т));
		КонецЦикла;
		Стр = СтрСоединить(Части, ", ");
		Если ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
			Попытка
				Кв = ОписаниеТипов.КвалификаторыСтроки.Длина;
				Если Кв > 0 Тогда Стр = Стр + "(" + Кв + ")"; КонецЕсли;
			Исключение КонецПопытки;
		КонецЕсли;
		Возврат Стр;
	Исключение
		Возврат Строка(ОписаниеТипов);
	КонецПопытки;
КонецФункции

#Область JSONСхема
Функция СобратьJSONСхему() Экспорт
	// Компакт JSON вместо XML: {"v":"3.0.204.22","p":"8.3.27","ext":[...],"dict":1,"objs":[{"p":"Д.","n":"ПутевойЛист","s":"...","f":[...]}]}
	Попытка
		Объекты = Новый Массив;
		СлПреф = СловарьПрефиксов();
		Проц = Новый Массив;
		Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Документы, "Документ"));
		Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Справочники, "Справочник"));
		Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.РегистрыСведений, "РегистрСведений"));
		Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.РегистрыНакопления, "РегистрНакопления"));
		Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.РегистрыБухгалтерии, "РегистрБухгалтерии"));
		Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик"));
		Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Перечисления, "Перечисление"));
		Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.БизнесПроцессы, "БизнесПроцесс"));
		Проц.Добавить(Новый Структура("Коллекция, Префикс", Метаданные.Задачи, "Задача"));
		Для Каждого Эл Из Проц Цикл
			Колл = Эл.Коллекция; Преф = Эл.Префикс;
			СокрПреф = ?(СлПреф.Получить(Преф) <> Неопределено, СлПреф.Получить(Преф), Преф + ".");
			Для Каждого ОбъектМД Из Колл Цикл
				Попытка
					Поля = Новый Массив;
					Попытка Для Каждого Рекв Из ОбъектМД.Реквизиты Цикл Поля.Добавить(Новый Структура("n,t", Рекв.Имя, ОписаниеТипаСокращенно(Рекв.Тип))); КонецЦикла; Исключение КонецПопытки;
					Попытка Для Каждого Изм Из ОбъектМД.Измерения Цикл Поля.Добавить(Новый Структура("n,t", Изм.Имя, ОписаниеТипаСокращенно(Изм.Тип))); КонецЦикла; Исключение КонецПопытки;
					Попытка Для Каждого Рес Из ОбъектМД.Ресурсы Цикл Поля.Добавить(Новый Структура("n,t", Рес.Имя, ОписаниеТипаСокращенно(Рес.Тип))); КонецЦикла; Исключение КонецПопытки;
					Попытка Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
						ТЧПоля = Новый Массив; Для Каждого РК Из ТЧ.Реквизиты Цикл ТЧПоля.Добавить(Новый Структура("n,t", РК.Имя, ОписаниеТипаСокращенно(РК.Тип))); КонецЦикла;
						Поля.Добавить(Новый Структура("n,t,sub", ТЧ.Имя, "", ТЧПоля));
					КонецЦикла; Исключение КонецПопытки;
					// Движения документа -> регистры проводок (для ответа "в какие регистры")
					Движ = Новый Массив;
					Попытка Для Каждого Рег Из ОбъектМД.Движения Цикл
						Попытка Движ.Добавить(Строка(Рег.ПолноеИмя())); Исключение Попытка Движ.Добавить(Рег.Имя); Исключение КонецПопытки; КонецПопытки;
					КонецЦикла; Исключение КонецПопытки;
					Син = "";
					Попытка Син = ОбъектМД.Синоним; Исключение КонецПопытки;
					Структ = Новый Структура("p,n,s,f", СокрПреф, ОбъектМД.Имя, Син, Поля);
					Если Движ.Количество() > 0 Тогда Структ.Вставить("mov", Движ); КонецЕсли;
					Объекты.Добавить(Структ);
				Исключение КонецПопытки;
			КонецЦикла;
		КонецЦикла;
		Корень = Новый Структура;
		Попытка СистИнфо = Новый СистемнаяИнформация; Платф = СистИнфо.ВерсияПриложения; Исключение Платф = ""; КонецПопытки;
		Корень.Вставить("v", Строка(Метаданные.Версия));
		Корень.Вставить("p", Платф);
		Корень.Вставить("cfg", Метаданные.Имя);
		Корень.Вставить("dict", ВерсияСловаря());
		Корень.Вставить("ext", СобратьВерсииРасширений());
		Корень.Вставить("objs", Объекты);
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Корень);
		Возврат Запись.Закрыть();
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции
#КонецОбласти

#Область СловарьСокращений
// Обязательно со схемой — ИИ без словаря не поймет Д./С./РС.

