			ЗаписатьXML(мЗаписьXML, "", "Типы");

		

		мЗаписьXML.ЗаписатьКонецЭлемента(); // "CatalogObject.Свойства"

		

		Для каждого Свойство из ТабличнаяЧасть.Реквизиты Цикл

			

